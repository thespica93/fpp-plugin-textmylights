#!/bin/bash
###############################################################################
# Text My Lights - shared-memory permission helper (runs as root via sudo)
#
# Makes ONE FPP overlay-model shared-memory file writable by the fpp user so the
# plugin can draw text/images into it. This is the ONLY privileged action the
# plugin is allowed to run as root (see /etc/sudoers.d/90-fpp-sms-shm), replacing
# an earlier broad world-writable rule over all FPP-Model-Data files.
#
# The file is given to the fpp user/group (group-writable, NOT world) so only the
# plugin - not every local account - can write into the overlay buffer.
#
# It accepts a single model NAME and only ever touches
#   /dev/shm/FPP-Model-Data-<name>
# The name is rejected if it is empty or contains a slash, so it can never be
# used to change permissions on a file outside /dev/shm (no path traversal).
###############################################################################
set -eu

name="${1-}"

# Reject empty, or any name containing a path separator or NUL. Without a slash,
# the target is always a single file directly inside /dev/shm.
case "$name" in
    "" | */* )
        echo "tml-fix-shm-perms: invalid model name" >&2
        exit 1
        ;;
esac

target="/dev/shm/FPP-Model-Data-${name}"

# Reject a SYMLINK outright. /dev/shm is world-writable (sticky), so another local user
# could plant a symlink named FPP-Model-Data-<name> pointing at, say, /etc/shadow; chowning
# it as root would follow the link and hand that file to the fpp user (privilege escalation).
# -L tests the path itself without following it. (Note: -f below follows symlinks, so this
# check MUST come first.)
if [ -L "$target" ]; then
    echo "tml-fix-shm-perms: refusing symlink target" >&2
    exit 1
fi

# Only act on a regular file that actually exists; never create anything.
if [ ! -f "$target" ]; then
    echo "tml-fix-shm-perms: no such shm file" >&2
    exit 1
fi

# Hand the file to the fpp user/group and make it group-writable only (660, no world
# access). chown is needed because FPP creates the file owned by root:root, so group perms
# alone would not let the fpp user write. -h (no-dereference) so that even if the path is
# swapped for a symlink right after the check (TOCTOU), chown acts on the link, not its target.
/usr/bin/chown -h fpp:fpp "$target"
exec /usr/bin/chmod 660 "$target"
